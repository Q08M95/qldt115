# Sao chép file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local)
# Lấy ở Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHỈ dùng ở server (Server Actions), KHÔNG đặt tiền tố NEXT_PUBLIC_ và KHÔNG commit. Có toàn quyền bỏ qua RLS.
# Lấy ở Supabase Dashboard > Project Settings > API > service_role. Cần cho: thêm nhân sự, đặt lại mật khẩu.
SUPABASE_SERVICE_ROLE_KEY=
